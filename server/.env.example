# ─── Server environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git.

# Database: SQLite file path (Prisma creates this automatically)
DATABASE_URL="file:./dev.db"

# JWT Secret: change this to a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change_this_to_a_long_random_secret_in_production"

# JWT expiry
JWT_EXPIRES_IN="7d"

# Server port
PORT=5000

# Frontend URL for CORS (must match where Vite runs)
CLIENT_URL="http://localhost:5173"

# Auto-approve milestones after this many days of no client response
AUTO_APPROVE_DAYS=7

# Max top-up per call in paise (100000 paise = ₹1000)
MAX_TOPUP_PAISE=100000000
