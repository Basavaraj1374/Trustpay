# ── Dependencies ──────────────────────────────────────────────
node_modules/
dist/
build/

# ── Environment ────────────────────────────────────────────────
.env
# Never commit .env – it has secrets (JWT secret, DB path)
# Use .env.example as a template

# ── Database ───────────────────────────────────────────────────
*.db
*.db-journal
# SQLite database file – not committed (generated by Prisma)

# ── Generated files ────────────────────────────────────────────
server/invoices/*.pdf
server/uploads/*

# ── OS junk ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
